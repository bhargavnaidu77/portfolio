# Web3Forms — contact form delivery (https://web3forms.com)
# Free, no account required. Sign up with the email you want messages sent to,
# confirm via the link they send, and paste the access key here.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Google Analytics 4 measurement ID (format: G-XXXXXXXXXX)
# Create a GA4 property at https://analytics.google.com and paste the
# Measurement ID from Admin → Data Streams → Web. Analytics only loads in
# production builds, so local `next dev` traffic will not be tracked.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
